---
import HeaderIsland from '../components/HeaderIsland.astro';
import StickyNavMenuIsland from '../components/StickyNavMenuIsland.astro';
import Footer from '../components/Footer.astro';
import ZaloBoxIsland from '../components/ZaloBoxIsland.astro';
import CallBoxIsland from '../components/CallBoxIsland.astro';
import MobileHomeHeaderIsland from '../components/mobile/MobileHomeHeaderIsland.astro';
// import MobileHomeTabsIsland from '../components/mobile/MobileHomeTabsIsland.astro';
import MobileBestsellerProductsIsland from '../components/mobile/MobileBestsellerProductsIsland.astro';
import MobileFeatureProductIsland from '../components/mobile/MobileFeatureProductIsland.astro';
import BottomNavIsland from '../components/mobile/BottomNavIsland.astro';
import { ViewTransitions } from 'astro:transitions';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import AnalyticsTracker from '../components/AnalyticsTracker.astro';
import { SEO } from 'astro-seo';
import '../styles/contact-buttons.css';
import '../styles/global.css';
import '../styles/antd.css';

export interface Props {
	title: string;
	description?: string;
	image?: string;
	imageAlt?: string;
	canonical?: string;
	type?: 'website' | 'article' | 'product';
	keywords?: string[];
	noIndex?: boolean;
	noFollow?: boolean;
	showMobileHomeComponents?: boolean;
	hideMobileHeader?: boolean;
	// SEO specific props
	price?: number;
	originalPrice?: number;
	brand?: string;
	category?: string;
}

const { 
	title, 
	description = 'G-3.vn - Cửa hàng chuyên cung cấp ghế công thái học, bàn nâng hạ điều chỉnh chiều cao chất lượng cao. Bảo hành chính hãng, giao hàng toàn quốc, tư vấn miễn phí.', 
	image, 
	imageAlt,
	canonical,
	type = 'website',
	keywords = [],
	noIndex = false,
	noFollow = false,
	showMobileHomeComponents = false,
	hideMobileHeader = false,
	price,
	originalPrice,
	brand,
	category
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="vi" class="h-full">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5" />
		
		<ViewTransitions />
		
		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="mask-icon" href="/masked-icon.svg" color="#000000" />
		
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#ffffff" />
		
		<!-- Preconnect to external domains -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link rel="preconnect" href="https://cdn.g-3.vn" crossorigin="anonymous" />
		
		<!-- PWA manifest -->
		<link rel="manifest" href="/manifest.json" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="apple-mobile-web-app-title" content="G3 Store" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		
		<!-- SEO with astro-seo -->
		<SEO
			title={title}
			description={description}
			canonical={canonicalURL}
			noindex={noIndex}
			nofollow={noFollow}
			openGraph={{
				basic: {
					title: title,
					type: type,
					image: image || 'https://g-3.vn/images/og-default.jpg',
					url: canonicalURL,
				},
				optional: {
					description: description,
					locale: 'vi_VN',
					siteName: 'G-3.vn',
				},
				...(type === 'product' && price && {
					product: {
						price: {
							amount: price,
							currency: 'VND'
						},
						availability: 'in_stock',
						brand: brand,
						category: category,
						...(originalPrice && originalPrice > price && {
							originalPrice: originalPrice
						})
					}
				})
			}}
			twitter={{
				card: 'summary_large_image',
				site: '@g3techvn',
				creator: '@g3techvn',
				title: title,
				description: description,
				image: image || 'https://g-3.vn/images/og-default.jpg',
			}}
			extend={{
				link: [
					{ rel: 'sitemap', href: '/sitemap-index.xml' },
				],
				meta: [
					// Vietnamese social media (Zalo)
					{ name: 'zalo-platform-site-verification', content: 'zalo_verification_code' },
					{ property: 'zalo:title', content: title },
					{ property: 'zalo:description', content: description },
					{ property: 'zalo:image', content: image || 'https://g-3.vn/images/og-default.jpg' },
					{ property: 'zalo:url', content: canonicalURL },
					
					// Vietnamese local SEO
					{ name: 'geo.region', content: 'VN' },
					{ name: 'geo.placename', content: 'Hồ Chí Minh' },
					{ name: 'geo.position', content: '10.7769;106.7009' },
					{ name: 'ICBM', content: '10.7769, 106.7009' },
					
					// Business info
					{ name: 'author', content: 'G3Tech Vietnam' },
					{ name: 'publisher', content: 'G3Tech Vietnam' },
					{ name: 'copyright', content: `© ${new Date().getFullYear()} G3Tech Vietnam` },
					
					// Keywords (Vietnamese focused)
					...(keywords.length > 0 ? [{ name: 'keywords', content: keywords.join(', ') }] : [
						{ name: 'keywords', content: `${title}, ${brand || 'G3Tech'}, ghế công thái học, bàn làm việc, nội thất văn phòng, Việt Nam, G-3.vn` }
					]),
					
					// Additional structured data for products
					...(type === 'product' && price ? [
						{ name: 'product:price:amount', content: price.toString() },
						{ name: 'product:price:currency', content: 'VND' },
						{ name: 'product:availability', content: 'in_stock' },
						...(brand ? [{ name: 'product:brand', content: brand }] : []),
						...(category ? [{ name: 'product:category', content: category }] : []),
					] : [])
				]
			}}
		/>

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
		
		<!-- Google Analytics with Partytown (Optimized) -->
		<GoogleAnalytics />
		
		<!-- Analytics Auto-Tracking -->
		<AnalyticsTracker />
	</head>
	<body class="h-full font-sans min-h-screen" transition:animate="fade">
		<!-- Mobile Layout -->
		<div class="md:hidden bg-white">
			<!-- Mobile Header - hiển thị ở tất cả các trang -->
			<MobileHomeHeaderIsland />
			
			{showMobileHomeComponents && (
				<>
					<!-- <MobileHomeTabsIsland /> -->
					<MobileBestsellerProductsIsland />
					<MobileFeatureProductIsland />
				</>
			)}
			
			<!-- Mobile Content -->
			<main class=" pb-20">
				<slot />
			</main>
			
			<!-- Bottom Navigation -->
			<BottomNavIsland />
		</div>

		<!-- Desktop Layout -->
		<div class="hidden md:block bg-gray-100">
			<!-- React Header Island -->
			<HeaderIsland />
			<!-- React StickyNavMenu Island -->
			<StickyNavMenuIsland />
			<!-- Main Content -->
			<main class="pl-16 mt-12 bg-gray-100">
				<div class="mx-auto px-0">
					<slot />
				</div>
			</main>
		</div>

		<!-- Footer - Hidden on mobile -->
		<div class="hidden md:block pl-16 mt-12">
			<Footer />
		</div>

		<!-- Fixed Contact Buttons -->
		<div class="fixed bottom-4 right-4 z-50 flex flex-col gap-4 ">
			
			<ZaloBoxIsland />
		</div>
		<div class="fixed bottom-4 right-4 z-50 flex flex-col gap-4 hidden md:block">
			<CallBoxIsland />
			
		</div>

		<!-- Service Worker Registration -->
		<script>
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', function() {
					navigator.serviceWorker.register('/sw.js').then(
						function(registration) {
							console.log('Service Worker registration successful with scope: ', registration.scope);
						},
						function(err) {
							console.log('Service Worker registration failed: ', err);
						}
					);
				});
			}
		</script>
	</body>
</html>


