---
import HeaderIsland from '../components/HeaderIsland.astro';
import StickyNavMenuIsland from '../components/StickyNavMenuIsland.astro';
import Footer from '../components/Footer.astro';
import ZaloBoxIsland from '../components/ZaloBoxIsland.astro';
import CallBoxIsland from '../components/CallBoxIsland.astro';
import MobileHomeHeaderIsland from '../components/mobile/MobileHomeHeaderIsland.astro';
// import MobileHomeTabsIsland from '../components/mobile/MobileHomeTabsIsland.astro';
import MobileBestsellerProductsIsland from '../components/mobile/MobileBestsellerProductsIsland.astro';
import MobileFeatureProductIsland from '../components/mobile/MobileFeatureProductIsland.astro';
import BottomNavIsland from '../components/mobile/BottomNavIsland.astro';
import { ViewTransitions } from 'astro:transitions';
import '../styles/contact-buttons.css';
import '../styles/global.css';
import '../styles/antd.css';

export interface Props {
	title: string;
	description?: string;
	image?: string;
	showMobileHomeComponents?: boolean;
}

const { title, description = 'G-3.vn - Cung cấp các sản phẩm chất lượng cao', image, showMobileHomeComponents = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="vi" class="h-full">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5" />
		
		<ViewTransitions />
		
		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="mask-icon" href="/masked-icon.svg" color="#000000" />
		
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#ffffff" />
		
		<!-- Preconnect to external domains -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link rel="preconnect" href="https://cdn.g-3.vn" crossorigin="anonymous" />
		
		<!-- PWA manifest -->
		<link rel="manifest" href="/manifest.json" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="apple-mobile-web-app-title" content="G3 Store" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		
		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="vi_VN" />
		{image && <meta property="og:image" content={image} />}
		
		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{image && <meta name="twitter:image" content={image} />}
		
		<!-- Structured Data -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "WebSite",
				"name": "G-3.vn",
				"description": description,
				"url": canonicalURL
			}
		</script>

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body class="h-full font-sans min-h-screen" transition:animate="fade">
		<!-- Mobile Layout -->
		<div class="md:hidden bg-white">
			<!-- Mobile Header - hiển thị ở tất cả các trang -->
			<MobileHomeHeaderIsland />
			
			{showMobileHomeComponents && (
				<>
					<!-- <MobileHomeTabsIsland /> -->
					<MobileBestsellerProductsIsland />
					<MobileFeatureProductIsland />
				</>
			)}
			
			<!-- Mobile Content -->
			<main class="py-4 pb-20">
				<slot />
			</main>
			
			<!-- Bottom Navigation -->
			<BottomNavIsland />
		</div>

		<!-- Desktop Layout -->
		<div class="hidden md:block bg-gray-100">
			<!-- React Header Island -->
			<HeaderIsland />
			<!-- React StickyNavMenu Island -->
			<StickyNavMenuIsland />
			<!-- Main Content -->
			<main class="pl-16 mt-12 bg-gray-100">
				<div class="mx-auto px-0">
					<slot />
				</div>
			</main>
		</div>

		<!-- Footer - Hidden on mobile -->
		<div class="hidden md:block">
			<Footer />
		</div>

		<!-- Fixed Contact Buttons -->
		<div class="fixed bottom-4 right-4 z-50 flex flex-col gap-4 ">
			
			<ZaloBoxIsland />
		</div>
		<div class="fixed bottom-4 right-4 z-50 flex flex-col gap-4 hidden md:block">
			<CallBoxIsland />
			
		</div>

		<!-- Service Worker Registration -->
		<script>
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', function() {
					navigator.serviceWorker.register('/sw.js').then(
						function(registration) {
							console.log('Service Worker registration successful with scope: ', registration.scope);
						},
						function(err) {
							console.log('Service Worker registration failed: ', err);
						}
					);
				});
			}
		</script>
	</body>
</html>


