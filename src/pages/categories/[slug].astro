---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

export async function getStaticPaths() {
  // Fetch all categories to generate static paths
  let categories: Array<{ id: string; slug: string; title: string; image_url?: string; description?: string }> = [];
  
  try {
    const { data, error } = await supabase
      .from('product_cats')
      .select('id, slug, title, image_url, description')
      .order('title', { ascending: true });

    if (!error && data) {
      categories = data;
    }
  } catch (error) {
    console.error('Error fetching categories for static paths:', error);
  }

  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category }
  }));
}

const { slug } = Astro.params;
const { category } = Astro.props;

let products: Array<{
  id: number;
  name: string;
  price: number;
  image_url?: string;
  image_square_url?: string;
  slug: string;
  brand_id?: number;
  pd_cat_id?: number;
  category_name?: string;
  video_url?: string;
}> = [];

let categoryInfo: {
  title: string;
  description?: string;
  image_url?: string;
} = {
  title: category?.title || slug || 'Danh mục sản phẩm',
  description: category?.description,
  image_url: category?.image_url
};

let brands: Array<{
  id: number;
  title: string;
  slug: string;
}> = [];

try {
  // Lấy sản phẩm theo danh mục
  const { data: productsData, error: productsError } = await supabase
    .from('products')
    .select(`
      *,
      brands(title, slug),
      product_cats(title, slug)
    `)
    .eq('pd_cat_id', category?.id)
    .order('name', { ascending: true });

  if (!productsError && productsData) {
    products = productsData;
  }

  // Lấy danh sách thương hiệu cho filter
  const { data: brandsData, error: brandsError } = await supabase
    .from('brands')
    .select('id, title, slug')
    .order('title', { ascending: true });

  if (!brandsError && brandsData) {
    brands = brandsData;
  }
} catch (error) {
  console.error('Error fetching data:', error);
}

const title = `${categoryInfo.title} | G3 - Công Thái Học`;
const description = categoryInfo.description || `Khám phá các sản phẩm thuộc danh mục ${categoryInfo.title} tại G3.vn. Nội thất công thái học, bảo hành 12 tháng, giao hàng toàn quốc.`;

console.log('Category data:', { category, categoryId: category?.id, slug });
---

<Layout title={title} description={description}>
  <!-- Mobile Header -->
  <div class="md:hidden bg-white border-b border-gray-200">
    <div class="flex items-center px-4 py-4">
      <a href="/categories" class="mr-3">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </a>
      <div class="flex items-center">
        {categoryInfo.image_url && (
          <img src={categoryInfo.image_url} alt={categoryInfo.title} class="w-10 h-10 rounded-full mr-3" />
        )}
        <div>
          <h1 class="text-lg font-semibold text-gray-900">{categoryInfo.title}</h1>
          <p class="text-sm text-gray-600">{products.length} sản phẩm</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Desktop Content -->
  <div class="hidden md:block mx-10 py-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-6">
      <!-- Sidebar Filter -->
      <div class="md:col-span-1">
        <div class="bg-white rounded-lg border border-gray-200 p-4 sticky top-4">
          <h3 class="font-semibold text-gray-900 mb-4">Bộ lọc</h3>
          
          <!-- Brand Filter -->
          <div class="mb-6">
            <h4 class="font-medium text-gray-900 mb-3">Thương hiệu</h4>
            <div class="space-y-2" id="brand-filter">
              <!-- Brands will be populated by JavaScript -->
            </div>
          </div>

          <!-- Price Filter -->
          <div class="mb-6">
            <h4 class="font-medium text-gray-900 mb-3">Khoảng giá</h4>
            <div class="space-y-2" id="price-filter">
              <!-- Price ranges will be populated by JavaScript -->
            </div>
          </div>
        </div>
      </div>

      <!-- Products Grid -->
      <div class="md:col-span-5">
        <!-- Combined Breadcrumb and Controls -->
        <div class="bg-white rounded-lg border border-gray-200 p-4 mb-6">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <nav class="flex text-sm">
              <a href="/" class="text-gray-500 hover:text-gray-700">Trang chủ</a>
              <span class="mx-2 text-gray-400">/</span>
              <a href="/categories" class="text-gray-500 hover:text-gray-700">Danh mục</a>
              <span class="mx-2 text-gray-400">/</span>
              <span class="text-gray-900">{categoryInfo.title}</span>
            </nav>
            
            <div class="flex items-center gap-4">
              <span class="text-sm text-gray-600" id="product-count">
                Hiển thị {products.length} sản phẩm
              </span>
              
              <!-- Sort dropdown -->
              <select id="sort-select" class="px-3 py-2 border border-gray-300 rounded-md text-sm">
                <option value="name">Tên A-Z</option>
                <option value="price_asc">Giá thấp đến cao</option>
                <option value="price_desc">Giá cao đến thấp</option>
              </select>

              <!-- View mode toggle -->
              <div class="flex rounded-md border border-gray-300 overflow-hidden">
                <button id="grid-view" class="p-2 bg-red-600 text-white">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM11 13a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                  </svg>
                </button>
                <button id="list-view" class="p-2 bg-white text-gray-600">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 8a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 12a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 16a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Products -->
        <div id="products-container">
          {products.length > 0 ? (
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5" id="products-grid">
              {products.map((product: any) => (
                <a href={`/san-pham/${product.slug}`} class="block product-item" data-price={product.price} data-brand={product.brand_id}>
                  <div class="bg-white rounded-xl border border-gray-200 shadow-sm flex flex-col h-full overflow-hidden">
                    <div class="aspect-square w-full">
                      <img
                        src={product.image_square_url || product.image_url || '/images/placeholder-product.jpg'}
                        alt={product.name}
                        class="object-contain w-full h-full"
                      />
                    </div>
                    <div class="flex-1 flex flex-col px-2 pt-2 pb-1">
                      <div class="h-10 font-medium text-sm text-gray-900 line-clamp-2 mb-1">{product.name}</div>
                      <div class="flex items-end gap-2 mb-1 mt-auto">
                        <span class="text-red-600 font-bold text-base">{product.price.toLocaleString('vi-VN')}₫</span>
                        {product.original_price && (
                          <span class="text-xs text-gray-400 line-through">{product.original_price.toLocaleString('vi-VN')}₫</span>
                        )}
                      </div>
                      <div class="flex items-center justify-between gap-2 text-xs text-gray-500 mb-1">
                        <div class="flex items-center gap-2">
                          <span class="flex items-center gap-0.5">
                            <svg class="w-3 h-3 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                              <polygon points="9.9,1.1 7.6,6.6 1.6,7.3 6.1,11.2 4.8,17.1 9.9,14.1 15,17.1 13.7,11.2 18.2,7.3 12.2,6.6 " />
                            </svg>
                            {(product.rating || 4.9).toFixed(1)}
                          </span>
                          <span>•</span>
                          <span>Đã bán {product.sold_count || 0}</span>
                        </div>
                        <button 
                          class="p-1.5 bg-red-600 text-white rounded-full shadow hover:bg-red-700 transition-colors duration-200"
                          aria-label="Thêm vào giỏ hàng"
                          data-product-id={product.id}
                          data-product-name={product.name}
                          data-product-price={product.price}
                          data-product-image={product.image_url}
                          data-product-slug={product.slug}
                          onclick="addToCartFromData(event, this)"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                          </svg>
                        </button>
                      </div>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <div class="bg-white rounded-lg border border-gray-200 p-8 text-center">
              <p class="text-lg text-gray-600">Không tìm thấy sản phẩm nào trong danh mục này.</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ category, products, brands }}>
    // Initialize page data
    let allProducts = products || [];
    let filteredProducts = [...allProducts];
    let currentViewMode = 'grid';
    let currentSort = 'name';

    // Add price ranges to filter with product count
    function populatePriceFilter() {
      const priceFilter = document.getElementById('price-filter');
      if (!priceFilter) return;
      
      // Clear existing content first
      priceFilter.innerHTML = '';
      
      // Define price ranges
      const priceRanges = [
        { value: 'under_500k', label: 'Dưới 500.000₫', min: 0, max: 500000 },
        { value: '500k_1m', label: '500.000₫ - 1.000.000₫', min: 500000, max: 1000000 },
        { value: '1m_2m', label: '1.000.000₫ - 2.000.000₫', min: 1000000, max: 2000000 },
        { value: 'over_2m', label: 'Trên 2.000.000₫', min: 2000000, max: null }
      ];
      
      // Count products in each price range
      priceRanges.forEach(range => {
        const count = allProducts.filter(product => {
          const price = product.price;
          if (range.max) {
            return price >= range.min && price <= range.max;
          } else {
            return price >= range.min;
          }
        }).length;
        
        if (count > 0) {
          const label = document.createElement('label');
          label.className = 'flex items-center justify-between';
          label.innerHTML = `
            <div class="flex items-center">
              <input type="checkbox" class="rounded border-gray-300 text-red-600 focus:ring-red-500" value="${range.value}">
              <span class="ml-2 text-sm text-gray-600">${range.label}</span>
            </div>
            <span class="text-xs text-gray-500">(${count})</span>
          `;
          priceFilter.appendChild(label);
        }
      });
    }

    // Add brands to filter
    function populateBrandFilter() {
      const brandFilter = document.getElementById('brand-filter');
      if (!brandFilter) return;
      
      // Clear existing content first
      brandFilter.innerHTML = '';
      
      // Get unique brands from products with count
      const brandsMap = new Map();
      allProducts.forEach(product => {
        if (product.brand_id && product.brands?.title) {
          const existingBrand = brandsMap.get(product.brand_id);
          if (existingBrand) {
            existingBrand.count += 1;
          } else {
            brandsMap.set(product.brand_id, { 
              id: product.brand_id, 
              name: product.brands.title, 
              count: 1 
            });
          }
        }
      });
      
      // Convert map to array and sort
      const productBrands = Array.from(brandsMap.values())
        .sort((a, b) => a.name.localeCompare(b.name));
      
      productBrands.forEach(brand => {
        const label = document.createElement('label');
        label.className = 'flex items-center justify-between';
        label.innerHTML = `
          <div class="flex items-center">
            <input type="checkbox" class="rounded border-gray-300 text-red-600 focus:ring-red-500 brand-filter" value="${brand.id}">
            <span class="ml-2 text-sm text-gray-600">${brand.name}</span>
          </div>
          <span class="text-xs text-gray-500">(${brand.count})</span>
        `;
        brandFilter.appendChild(label);
      });
    }

    // Filter products
    function filterProducts() {
      const priceFilters = Array.from(document.querySelectorAll('input[type="checkbox"]:not(.brand-filter):checked')).map(cb => cb.value);
      const brandFilters = Array.from(document.querySelectorAll('.brand-filter:checked')).map(cb => parseInt(cb.value));
      
      filteredProducts = allProducts.filter(product => {
        // Price filter
        if (priceFilters.length > 0) {
          const price = product.price;
          const matchesPrice = priceFilters.some(filter => {
            switch (filter) {
              case 'under_500k': return price < 500000;
              case '500k_1m': return price >= 500000 && price <= 1000000;
              case '1m_2m': return price >= 1000000 && price <= 2000000;
              case 'over_2m': return price > 2000000;
              default: return true;
            }
          });
          if (!matchesPrice) return false;
        }
        
        // Brand filter
        if (brandFilters.length > 0) {
          if (!brandFilters.includes(product.brand_id)) return false;
        }
        
        return true;
      });
      
      sortProducts();
      renderProducts();
      updateProductCount();
    }

    // Sort products
    function sortProducts() {
      filteredProducts.sort((a, b) => {
        switch (currentSort) {
          case 'price_asc': return a.price - b.price;
          case 'price_desc': return b.price - a.price;
          case 'name':
          default: return a.name.localeCompare(b.name);
        }
      });
    }

    // Render products
    function renderProducts() {
      const container = document.getElementById('products-grid');
      if (!container) return;
      
      container.className = currentViewMode === 'grid' 
        ? 'grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5'
        : 'space-y-4';
      
      container.innerHTML = filteredProducts.map(product => `
        <a href="/san-pham/${product.slug}" class="block">
          <div class="${currentViewMode === 'grid' 
            ? 'bg-white rounded-xl border border-gray-200 shadow-sm flex flex-col h-full overflow-hidden'
            : 'bg-white rounded-lg border border-gray-200 shadow-sm flex p-4'
          }">
            <div class="${currentViewMode === 'grid' ? 'aspect-square w-full' : 'w-24 h-24 flex-shrink-0'}">
              <img src="${product.image_square_url || product.image_url || '/images/placeholder-product.jpg'}" alt="${product.name}" class="object-contain w-full h-full">
            </div>
            <div class="${currentViewMode === 'grid' 
              ? 'flex-1 flex flex-col px-2 pt-2 pb-1'
              : 'flex-1 ml-4 flex flex-col justify-between'
            }">
              <div class="${currentViewMode === 'grid' ? 'h-10 font-medium text-sm text-gray-900 line-clamp-2 mb-1' : 'font-medium text-gray-900 mb-2'}">${product.name}</div>
              <div class="${currentViewMode === 'grid' ? 'flex items-end gap-2 mb-1 mt-auto' : 'flex items-end gap-2 mb-2'}">
                <span class="text-red-600 font-bold text-base">${product.price.toLocaleString('vi-VN')}₫</span>
                ${product.original_price ? `<span class="text-xs text-gray-400 line-through">${product.original_price.toLocaleString('vi-VN')}₫</span>` : ''}
              </div>
              <div class="flex items-center justify-between gap-2 text-xs text-gray-500 mb-1">
                <div class="flex items-center gap-2">
                  <span class="flex items-center gap-0.5">
                    <svg class="w-3 h-3 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                      <polygon points="9.9,1.1 7.6,6.6 1.6,7.3 6.1,11.2 4.8,17.1 9.9,14.1 15,17.1 13.7,11.2 18.2,7.3 12.2,6.6 "/>
                    </svg>
                    ${(product.rating || 4.9).toFixed(1)}
                  </span>
                  <span>•</span>
                  <span>Đã bán ${product.sold_count || 0}</span>
                </div>
                <button class="p-1.5 bg-red-600 text-white rounded-full shadow hover:bg-red-700 transition-colors duration-200" onclick="addToCart(event, {id: ${product.id}, name: '${product.name}', price: ${product.price}, image_url: '${product.image_url}', slug: '${product.slug}'})">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </a>
      `).join('');
    }

    // Update product count
    function updateProductCount() {
      const countElement = document.getElementById('product-count');
      if (countElement) {
        countElement.textContent = `Hiển thị ${filteredProducts.length} sản phẩm`;
      }
    }

    // Initialize once when page loads
    let initialized = false;
    
    function init() {
      if (initialized) return;
      initialized = true;
      
      populatePriceFilter();
      populateBrandFilter();
      setupEventListeners();
    }
    
    function setupEventListeners() {
      // Remove existing listeners first
      const existingCheckboxes = document.querySelectorAll('input[type="checkbox"]');
      existingCheckboxes.forEach(cb => {
        cb.removeEventListener('change', handleFilterChange);
      });
      
      // Add event listeners for filters
      function handleFilterChange(e) {
        if (e.target.type === 'checkbox') {
          filterProducts();
        }
      }
      
      document.addEventListener('change', handleFilterChange);
      
      // Sort dropdown
      const sortSelect = document.getElementById('sort-select');
      if (sortSelect && !sortSelect.hasAttribute('data-initialized')) {
        sortSelect.setAttribute('data-initialized', 'true');
        sortSelect.addEventListener('change', function() {
          currentSort = this.value;
          sortProducts();
          renderProducts();
        });
      }
      
      // View mode buttons
      const gridView = document.getElementById('grid-view');
      const listView = document.getElementById('list-view');
      
      if (gridView && !gridView.hasAttribute('data-initialized')) {
        gridView.setAttribute('data-initialized', 'true');
        gridView.addEventListener('click', function() {
          currentViewMode = 'grid';
          this.className = 'p-2 bg-red-600 text-white';
          if (listView) listView.className = 'p-2 bg-white text-gray-600';
          renderProducts();
        });
      }
      
      if (listView && !listView.hasAttribute('data-initialized')) {
        listView.setAttribute('data-initialized', 'true');
        listView.addEventListener('click', function() {
          currentViewMode = 'list';
          this.className = 'p-2 bg-red-600 text-white';
          if (gridView) gridView.className = 'p-2 bg-white text-gray-600';
          renderProducts();
        });
      }
    }

    // Initialize immediately
    init();

    // Add to cart function
    function addToCart(event, product) {
      event.preventDefault();
      const existingCart = JSON.parse(localStorage.getItem('cart') || '[]');
      const existingItemIndex = existingCart.findIndex(item => item.id === product.id);
      
      if (existingItemIndex > -1) {
        existingCart[existingItemIndex].quantity += 1;
      } else {
        existingCart.push({ ...product, quantity: 1, image: product.image_url || '' });
      }
      
      localStorage.setItem('cart', JSON.stringify(existingCart));
      alert('Đã thêm sản phẩm vào giỏ hàng!');
    }

    // Function to add to cart from data attributes
    function addToCartFromData(event: Event, element: HTMLElement) {
      const product = {
        id: element.dataset.productId,
        name: element.dataset.productName,
        price: Number(element.dataset.productPrice),
        image_url: element.dataset.productImage,
        slug: element.dataset.productSlug
      };
      addToCart(event, product);
    }

    // Make functions globally available
    window.addToCart = addToCart;
    window.addToCartFromData = addToCartFromData;
  </script>
</Layout>

<style>
  .aspect-square {
    aspect-ratio: 1 / 1;
  }
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  // Function to add to cart
  function addToCart(event: Event, product: any) {
    event.preventDefault();
    
    // Get existing cart from localStorage
    const existingCart = JSON.parse(localStorage.getItem('cart') || '[]');
    
    // Check if product already exists in cart
    const existingItemIndex = existingCart.findIndex((item: any) => item.id === product.id);
    
    if (existingItemIndex > -1) {
      // Increment quantity if product already exists
      existingCart[existingItemIndex].quantity += 1;
    } else {
      // Add new product to cart
      existingCart.push({
        ...product,
        quantity: 1,
        image: product.image_url || ''
      });
    }
    
    // Save back to localStorage
    localStorage.setItem('cart', JSON.stringify(existingCart));
    
    // Show success message
    alert('Đã thêm sản phẩm vào giỏ hàng!');
  }
</script> 