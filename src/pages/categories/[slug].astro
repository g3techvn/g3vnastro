---
import Layout from "../../layouts/Layout.astro";
import { supabase } from "../../lib/supabase";
import CategoryPageWrapper from "../../components/react/CategoryPageWrapper";

export async function getStaticPaths() {
  // Fetch all categories to generate static paths
  let categories: Array<{
    id: string;
    slug: string;
    title: string;
    image_url?: string;
    description?: string;
  }> = [];

  try {
    const { data, error } = await supabase
      .from("product_cats")
      .select("id, slug, title, image_url, description")
      .order("title", { ascending: true });

    if (!error && data) {
      categories = data;
    }
  } catch (error) {
    console.error("Error fetching categories for static paths:", error);
  }

  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { slug } = Astro.params;
const { category } = Astro.props;

const categoryInfo = {
  title: category?.title || slug || "Danh mục sản phẩm",
  description: category?.description,
  image_url: category?.image_url,
};

const title = `${categoryInfo.title} | G3 - Công Thái Học`;
const description =
  categoryInfo.description ||
  `Khám phá các sản phẩm thuộc danh mục ${categoryInfo.title} tại G3.vn. Nội thất công thái học, bảo hành 12 tháng, giao hàng toàn quốc.`;
---

<Layout
  title={title}
  description={description}
  image={categoryInfo.image_url
    ? `https://g-3.vn${categoryInfo.image_url.replace(/^\/g3tech\//, "/g3tech-otm/").replace(/\.(jpg|jpeg|png|webp)$/i, ".avif")}`
    : "https://g-3.vn/images/og-default.jpg"}
  imageAlt={`${categoryInfo.title} - G-3.vn`}
  type="website"
  keywords={[
    categoryInfo.title,
    "G-3.vn",
    "ghế công thái học",
    "bàn làm việc",
    "nội thất văn phòng",
    "chất lượng cao",
  ]}
  canonical={`https://g-3.vn/categories/${category?.slug || slug}`}
>
  <CategoryPageWrapper
    categorySlug={slug}
    categoryData={category}
    client:load
  />
</Layout>
