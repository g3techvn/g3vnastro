---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';
import CategoryBuyNowModal from '../../components/react/CategoryBuyNowModal';

export async function getStaticPaths() {
  // Fetch all categories to generate static paths
  let categories: Array<{ id: string; slug: string; title: string; image_url?: string; description?: string }> = [];
  
  try {
    const { data, error } = await supabase
      .from('product_cats')
      .select('id, slug, title, image_url, description')
      .order('title', { ascending: true });

    if (!error && data) {
      categories = data;
    }
  } catch (error) {
    console.error('Error fetching categories for static paths:', error);
  }

  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category }
  }));
}

const { slug } = Astro.params;
const { category } = Astro.props;

let products: Array<{
  id: number;
  name: string;
  price: number;
  original_price?: number;
  image_url?: string;
  image_square_url?: string;
  slug: string;
  brand_id?: number;
  pd_cat_id?: number;
  category_name?: string;
  video_url?: string;
  rating?: number;
  sold_count?: number;
  brands?: { title: string; slug: string };
}> = [];

let categoryInfo: {
  title: string;
  description?: string;
  image_url?: string;
} = {
  title: category?.title || slug || 'Danh mục sản phẩm',
  description: category?.description,
  image_url: category?.image_url
};

let brands: Array<{
  id: number;
  title: string;
  slug: string;
}> = [];

try {
  // Lấy sản phẩm theo danh mục
  if (category?.id) {
    const { data: productsData, error: productsError } = await supabase
      .from('products')
      .select(`
        *,
        brands(title, slug),
        product_cats(title, slug)
      `)
      .eq('pd_cat_id', category.id)
      .order('name', { ascending: true });

    if (!productsError && productsData) {
      products = productsData;
    } else if (productsError) {
      console.error('Error fetching products:', productsError);
    }
  } else {
    console.warn('No category found for slug:', slug);
  }

  // Lấy danh sách thương hiệu cho filter
  const { data: brandsData, error: brandsError } = await supabase
    .from('brands')
    .select('id, title, slug')
    .order('title', { ascending: true });

  if (!brandsError && brandsData) {
    brands = brandsData;
  }
} catch (error) {
  console.error('Error fetching data:', error);
}

const title = `${categoryInfo.title} | G3 - Công Thái Học`;
const description = categoryInfo.description || `Khám phá các sản phẩm thuộc danh mục ${categoryInfo.title} tại G3.vn. Nội thất công thái học, bảo hành 12 tháng, giao hàng toàn quốc.`;


---

<Layout 
  title={title}
  description={description}
  image={categoryInfo.image_url ? `https://g-3.vn${categoryInfo.image_url.replace(/^\/g3tech\//, '/g3tech-otm/').replace(/\.(jpg|jpeg|png|webp)$/i, '.avif')}` : 'https://g-3.vn/images/og-default.jpg'}
  imageAlt={`${categoryInfo.title} - G-3.vn`}
  type="website"
  keywords={[categoryInfo.title, 'G-3.vn', 'ghế công thái học', 'bàn làm việc', 'nội thất văn phòng', 'chất lượng cao']}
  canonical={`https://g-3.vn/categories/${category?.slug || slug}`}
>
  <!-- Mobile Header -->
  <div class="md:hidden bg-white border-b border-gray-200">
    <div class="flex items-center px-4 py-4">
      <a href="/categories" class="mr-3">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </a>
      <div class="flex items-center">
        {categoryInfo.image_url && (
          <img src={categoryInfo.image_url} alt={categoryInfo.title} class="w-10 h-10 rounded-full mr-3" />
        )}
        <div>
          <h1 class="text-lg font-semibold text-gray-900">{categoryInfo.title}</h1>
          <p class="text-sm text-gray-600"><span id="mobile-product-count">{products.length}</span> sản phẩm</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Desktop Content -->
  <div class="hidden md:block mx-10 py-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-6">
      <!-- Sidebar Filter -->
      <div class="md:col-span-1">
        <div class="bg-white rounded-lg border border-gray-200 p-4 sticky top-4">
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-semibold text-gray-900">Bộ lọc</h3>
            <button id="clear-filters" class="text-sm text-red-600 hover:text-red-700 hidden">
              Xóa tất cả
            </button>
          </div>
          
          <!-- Brand Filter -->
          <div class="mb-6">
            <h4 class="font-medium text-gray-900 mb-3">Thương hiệu</h4>
            <div class="space-y-2" id="brand-filter">
              <!-- Brands will be populated by JavaScript -->
            </div>
          </div>

          <!-- Price Filter -->
          <div class="mb-6">
            <h4 class="font-medium text-gray-900 mb-3">Khoảng giá</h4>
            <div class="space-y-2" id="price-filter">
              <!-- Price ranges will be populated by JavaScript -->
            </div>
          </div>
        </div>
      </div>

      <!-- Products Grid -->
      <div class="md:col-span-5">
        <!-- Combined Breadcrumb and Controls -->
        <div class="bg-white rounded-lg border border-gray-200 p-4 mb-6">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                         <nav aria-label="Breadcrumb" class="flex">
               <ol role="list" class="flex items-center space-x-3 h-12">
                <li class="flex">
                  <div class="flex items-center">
                    <a href="/" class="text-gray-400 hover:text-gray-500">
                                             <svg class="size-4 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                        <path fill-rule="evenodd" d="M9.293 2.293a1 1 0 011.414 0l7 7A1 1 0 0117 11h-1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-3a1 1 0 00-1-1H9a1 1 0 00-1 1v3a1 1 0 01-1 1H5a1 1 0 01-1-1v-6H3a1 1 0 01-.707-1.707l7-7z" clip-rule="evenodd" />
                      </svg>
                      <span class="sr-only">Trang chủ</span>
                    </a>
                  </div>
                </li>
                <li class="flex">
                  <div class="flex items-center">
                    <svg
                      fill="currentColor"
                      viewBox="0 0 24 44"
                      preserveAspectRatio="none"
                      aria-hidden="true"
                      class="h-full w-5 shrink-0 text-gray-200"
                    >
                      <path d="M.293 0l22 22-22 22h1.414l22-22-22-22H.293z" />
                    </svg>
                    <a
                      href="/categories"
                      class="ml-4 text-sm font-medium text-gray-500 hover:text-gray-700"
                    >
                      Danh mục
                    </a>
                  </div>
                </li>
                <li class="flex">
                  <div class="flex items-center">
                    <svg
                      fill="currentColor"
                      viewBox="0 0 24 44"
                      preserveAspectRatio="none"
                      aria-hidden="true"
                      class="h-full w-5 shrink-0 text-gray-200"
                    >
                      <path d="M.293 0l22 22-22 22h1.414l22-22-22-22H.293z" />
                    </svg>
                    <span
                      aria-current="page"
                      class="ml-4 text-sm font-medium text-gray-900"
                    >
                      {categoryInfo.title}
                    </span>
                  </div>
                </li>
              </ol>
            </nav>
            
            <div class="flex items-center gap-4">
              <span class="text-sm text-gray-600" id="product-count">
                Hiển thị {products.length} sản phẩm
              </span>
              
              <!-- Sort dropdown -->
              <select id="sort-select" class="px-3 py-2 border border-gray-300 rounded-md text-sm">
                <option value="name">Tên A-Z</option>
                <option value="price_asc">Giá thấp đến cao</option>
                <option value="price_desc">Giá cao đến thấp</option>
              </select>

              <!-- View mode toggle -->
              <div class="flex rounded-md border border-gray-300 overflow-hidden">
                <button id="grid-view" class="p-2 bg-red-600 text-white">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM11 13a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                  </svg>
                </button>
                <button id="list-view" class="p-2 bg-white text-gray-600">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 8a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 12a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 16a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Products -->
        <div id="products-container">
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5" id="products-grid">
            <!-- Initial products rendered by server -->
            {products.length > 0 ? (
              products.map((product: any) => (
                <a href={`/san-pham/${product.slug}`} class="block">
                  <div class="bg-white rounded-xl border border-gray-200 shadow-sm flex flex-col h-full overflow-hidden">
                    <div class="aspect-square w-full relative group">
                      {product.original_price && product.original_price > product.price && (
                        <div class="absolute top-2 left-2 bg-red-600 text-white text-xs font-bold px-2 py-1 rounded-lg z-10">
                          -{Math.round(((product.original_price - product.price) / product.original_price) * 100)}%
                        </div>
                      )}
                      <img 
                        src={product.image_square_url || product.image_url || '/images/placeholder-product.jpg'} 
                        alt={product.name} 
                        class="object-contain w-full h-full"
                      />
                    </div>
                    <div class="flex-1 flex flex-col px-2 pt-2 pb-1">
                      <div class="h-10 font-medium text-sm text-gray-900 line-clamp-2 mb-1">{product.name}</div>
                      <div class="flex items-end gap-2 mb-1 mt-auto">
                        <span class="text-red-600 font-bold text-base">{product.price.toLocaleString('vi-VN')}₫</span>
                        {product.original_price && (
                          <span class="text-xs text-gray-400 line-through">{product.original_price.toLocaleString('vi-VN')}₫</span>
                        )}
                      </div>
                      <div class="flex items-center justify-between gap-2 text-xs text-gray-500 mb-1">
                        <div class="flex items-center gap-2">
                          <span class="flex items-center gap-0.5">
                            <svg class="w-3 h-3 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                              <polygon points="9.9,1.1 7.6,6.6 1.6,7.3 6.1,11.2 4.8,17.1 9.9,14.1 15,17.1 13.7,11.2 18.2,7.3 12.2,6.6"/>
                            </svg>
                            {(product.rating || 4.9).toFixed(1)}
                          </span>
                          <span>•</span>
                          <span>Đã bán {product.sold_count || 0}</span>
                        </div>
                        <button 
                          class="p-1.5 bg-red-600 text-white rounded-full shadow hover:bg-red-700 transition-colors duration-200"
                          data-product={JSON.stringify(product)}
                          onclick="handleBuyNowClick(this)"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                          </svg>
                        </button>
                      </div>
                    </div>
                  </div>
                </a>
              ))
            ) : (
              <div class="col-span-full bg-white rounded-lg border border-gray-200 p-8 text-center">
                <p class="text-lg text-gray-600">Không tìm thấy sản phẩm nào trong danh mục này.</p>
                <p class="mt-2 text-sm text-gray-500">Vui lòng kiểm tra lại danh mục hoặc thử danh mục khác.</p>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Filter Button -->
  <div class="md:hidden fixed bottom-20 left-4 right-4 z-10">
    <button id="mobile-filter-btn" class="w-full bg-white border border-gray-200 rounded-lg px-4 py-3 flex items-center justify-center shadow-lg">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M3 3a1 1 0 011-1h12a1 1 0 011 1v3a1 1 0 01-.293.707L12 11.414V15a1 1 0 01-.293.707l-2 2A1 1 0 018 17v-5.586L3.293 6.707A1 1 0 013 6V3z" clip-rule="evenodd" />
      </svg>
      <span class="text-gray-700">Bộ lọc sản phẩm</span>
    </button>
  </div>

  <!-- Mobile Filter Modal -->
  <div id="mobile-filter-modal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black bg-opacity-50" id="mobile-filter-backdrop"></div>
    <div class="absolute bottom-0 left-0 right-0 bg-white rounded-t-lg max-h-[80vh] overflow-y-auto">
      <div class="sticky top-0 bg-white border-b border-gray-200 p-4 flex items-center justify-between">
        <h3 class="text-lg font-semibold">Bộ lọc</h3>
        <button id="close-mobile-filter" class="text-gray-400 hover:text-gray-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="p-4">
        <div class="mb-6">
          <h4 class="font-medium text-gray-900 mb-3">Thương hiệu</h4>
          <div class="space-y-2" id="mobile-brand-filter">
            <!-- Mobile brands will be populated by JavaScript -->
          </div>
        </div>
        <div class="mb-6">
          <h4 class="font-medium text-gray-900 mb-3">Khoảng giá</h4>
          <div class="space-y-2" id="mobile-price-filter">
            <!-- Mobile price ranges will be populated by JavaScript -->
          </div>
        </div>
        <div class="flex gap-3 pt-4 border-t border-gray-200">
          <button id="mobile-clear-filters" class="flex-1 px-4 py-2 border border-gray-300 rounded-md text-gray-700">
            Xóa bộ lọc
          </button>
          <button id="mobile-apply-filters" class="flex-1 px-4 py-2 bg-red-600 text-white rounded-md">
            Áp dụng
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Preview popup placeholder -->
  <div id="preview-popup" class="fixed pointer-events-none z-[9999] hidden">
    <div class="bg-white rounded-xl border border-gray-200 shadow-2xl p-2">
      <img id="preview-image" class="w-96 h-96 object-contain rounded-xl" alt="Preview" />
    </div>
  </div>

  <!-- Category Buy Now Modal -->
  <CategoryBuyNowModal client:load />

  <script define:vars={{ category, products: products || [], brands: brands || [] }}>
    // Initialize page data
    let allProducts = products || [];
    let filteredProducts = [...allProducts];
    let currentViewMode = 'grid';
    let currentSort = 'name';
    let modalProduct = null;

    // Filter state - giống như React useState
    let filterState = {
      priceRange: [],
      brands: [],
      categories: []
    };

    // Preview functionality
    let preview = null;

    // Add price ranges to filter with product count
    function populatePriceFilter() {
      const priceFilter = document.getElementById('price-filter');
      const mobilePriceFilter = document.getElementById('mobile-price-filter');
      if (!priceFilter) return;
      
      // Clear existing content first
      priceFilter.innerHTML = '';
      if (mobilePriceFilter) mobilePriceFilter.innerHTML = '';
      
      // Define price ranges
      const priceRanges = [
        { value: 'under_500k', label: 'Dưới 500.000₫', min: 0, max: 500000 },
        { value: '500k_1m', label: '500.000₫ - 1.000.000₫', min: 500000, max: 1000000 },
        { value: '1m_2m', label: '1.000.000₫ - 2.000.000₫', min: 1000000, max: 2000000 },
        { value: 'over_2m', label: 'Trên 2.000.000₫', min: 2000000, max: null }
      ];
      
      // Count products in each price range
      priceRanges.forEach(range => {
        const count = allProducts.filter(product => {
          const price = product.price;
          if (range.max) {
            return price >= range.min && price <= range.max;
          } else {
            return price >= range.min;
          }
        }).length;
        
        if (count > 0) {
          const labelHTML = `
            <label class="flex items-center justify-between cursor-pointer">
              <div class="flex items-center">
                <input type="checkbox" class="rounded border-gray-300 text-red-600 focus:ring-red-500 price-filter" value="${range.value}" onchange="handlePriceRangeChange('${range.value}')">
                <span class="ml-2 text-sm text-gray-600">${range.label}</span>
              </div>
              <span class="text-xs text-gray-500">(${count})</span>
            </label>
          `;
          priceFilter.insertAdjacentHTML('beforeend', labelHTML);
          if (mobilePriceFilter) {
            mobilePriceFilter.insertAdjacentHTML('beforeend', labelHTML);
          }
        }
      });
    }

    // Add brands to filter
    function populateBrandFilter() {
      const brandFilter = document.getElementById('brand-filter');
      const mobileBrandFilter = document.getElementById('mobile-brand-filter');
      if (!brandFilter) return;
      
      // Clear existing content first
      brandFilter.innerHTML = '';
      if (mobileBrandFilter) mobileBrandFilter.innerHTML = '';
      
      // Get unique brands from products with count
      const brandsMap = new Map();
      allProducts.forEach(product => {
        if (product.brand_id && product.brands?.title) {
          const existingBrand = brandsMap.get(product.brand_id);
          if (existingBrand) {
            existingBrand.count += 1;
          } else {
            brandsMap.set(product.brand_id, { 
              id: product.brand_id, 
              name: product.brands.title, 
              count: 1 
            });
          }
        }
      });
      
      // Convert map to array and sort
      const productBrands = Array.from(brandsMap.values())
        .sort((a, b) => a.name.localeCompare(b.name));
      
      productBrands.forEach(brand => {
        const labelHTML = `
          <label class="flex items-center justify-between cursor-pointer">
            <div class="flex items-center">
              <input type="checkbox" class="rounded border-gray-300 text-red-600 focus:ring-red-500 brand-filter-input" value="${brand.id}" onchange="handleBrandChange('${brand.id}')">
              <span class="ml-2 text-sm text-gray-600">${brand.name}</span>
            </div>
            <span class="text-xs text-gray-500">(${brand.count})</span>
          </label>
        `;
        brandFilter.insertAdjacentHTML('beforeend', labelHTML);
        if (mobileBrandFilter) {
          mobileBrandFilter.insertAdjacentHTML('beforeend', labelHTML);
        }
      });
    }

    // Apply filters - giống ProductList.applyFilters
    function applyFilters() {
      let filtered = [...allProducts];

      // Apply price range filters
      if (filterState.priceRange.length > 0) {
        filtered = filtered.filter(product => {
          return filterState.priceRange.some(range => {
            switch (range) {
              case 'under_500k':
                return product.price < 500000;
              case '500k_1m':
                return product.price >= 500000 && product.price < 1000000;
              case '1m_2m':
                return product.price >= 1000000 && product.price < 2000000;
              case 'over_2m':
                return product.price >= 2000000;
              default:
                return true;
            }
          });
        });
      }

      // Apply brand filters - convert both to string for comparison
      if (filterState.brands.length > 0) {
        filtered = filtered.filter(product => {
          if (!product.brand_id) return false;
          return filterState.brands.includes(product.brand_id.toString());
        });
      }

      filteredProducts = filtered;
      
      // Apply sorting
      sortProducts();
      renderProducts();
      updateProductCount();
      updateClearButton();
      
      console.log('Filtered products:', filteredProducts.length, 'out of', allProducts.length);
    }

    // Handle price filter change - giống React component
    function handlePriceRangeChange(value) {
      if (filterState.priceRange.includes(value)) {
        filterState.priceRange = filterState.priceRange.filter(v => v !== value);
      } else {
        filterState.priceRange.push(value);
      }
      updateCheckboxStates();
      applyFilters();
    }

    // Handle brand filter change - giống React component  
    function handleBrandChange(brandId) {
      const brandIdStr = brandId.toString();
      if (filterState.brands.includes(brandIdStr)) {
        filterState.brands = filterState.brands.filter(id => id !== brandIdStr);
      } else {
        filterState.brands.push(brandIdStr);
      }
      updateCheckboxStates();
      applyFilters();
    }

    // Update checkbox states to match filter state
    function updateCheckboxStates() {
      // Update price checkboxes
      document.querySelectorAll('.price-filter').forEach(checkbox => {
        checkbox.checked = filterState.priceRange.includes(checkbox.value);
      });
      
      // Update brand checkboxes
      document.querySelectorAll('.brand-filter-input').forEach(checkbox => {
        checkbox.checked = filterState.brands.includes(checkbox.value);
      });
    }

    // Update clear button visibility
    function updateClearButton() {
      const clearBtn = document.getElementById('clear-filters');
      
      if (clearBtn) {
        const hasFilters = filterState.priceRange.length > 0 || filterState.brands.length > 0;
        if (hasFilters) {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }
      }
    }

    // Clear all filters
    function clearAllFilters() {
      // Reset filter state
      filterState = {
        priceRange: [],
        brands: [],
        categories: []
      };
      
      // Update checkboxes to match empty state
      updateCheckboxStates();
      
      // Apply empty filters
      applyFilters();
    }

    // Sort products
    function sortProducts() {
      filteredProducts.sort((a, b) => {
        switch (currentSort) {
          case 'price_asc': return a.price - b.price;
          case 'price_desc': return b.price - a.price;
          case 'name':
          default: return a.name.localeCompare(b.name);
        }
      });
    }

    // Show preview
    function showPreview(x, y, imageUrl) {
      const popup = document.getElementById('preview-popup');
      const image = document.getElementById('preview-image');
      if (popup && image) {
        image.src = imageUrl;
        popup.style.left = Math.min(x + 24, window.innerWidth - 400) + 'px';
        popup.style.top = Math.max(y - 200, 16) + 'px';
        popup.classList.remove('hidden');
      }
    }

    // Hide preview
    function hidePreview() {
      const popup = document.getElementById('preview-popup');
      if (popup) {
        popup.classList.add('hidden');
      }
    }

    // Render products
    function renderProducts() {
      const container = document.getElementById('products-grid');
      if (!container) {
        console.error('Products container not found');
        return;
      }
      

      

      
      if (filteredProducts.length === 0) {
        container.innerHTML = `
          <div class="col-span-full bg-white rounded-lg border border-gray-200 p-8 text-center">
            <p class="text-lg text-gray-600">Không tìm thấy sản phẩm nào trong danh mục này.</p>
            <p class="mt-2 text-sm text-gray-500">Vui lòng thử lại với bộ lọc khác.</p>
          </div>
        `;
        return;
      }
      
      container.className = currentViewMode === 'grid' 
        ? 'grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5'
        : 'space-y-4';
      
      container.innerHTML = filteredProducts.map(product => {
        const discountBadge = product.original_price && product.original_price > product.price ? 
          `<div class="absolute top-2 left-2 bg-red-600 text-white text-xs font-bold px-2 py-1 rounded-lg z-10">
            -${Math.round(((product.original_price - product.price) / product.original_price) * 100)}%
          </div>` : '';

        return `
          <a href="/san-pham/${product.slug}" class="block">
            <div class="${currentViewMode === 'grid' 
              ? 'bg-white rounded-xl border border-gray-200 shadow-sm flex flex-col h-full overflow-hidden'
              : 'bg-white rounded-lg border border-gray-200 shadow-sm flex p-4'
            }">
              <div class="${currentViewMode === 'grid' ? 'aspect-square w-full relative group' : 'w-24 h-24 flex-shrink-0 relative group'}">
                ${discountBadge}
                <img 
                  src="${product.image_square_url || product.image_url || '/images/placeholder-product.jpg'}" 
                  alt="${product.name}" 
                  class="object-contain w-full h-full"
                />
                <button
                  type="button"
                  class="absolute inset-0 flex items-center justify-center bg-black/0 hover:bg-black/10 rounded transition-all duration-200 opacity-0 group-hover:opacity-100 z-10"
                  onmouseenter="showPreview(event.clientX, event.clientY, '${product.image_url || '/images/placeholder-product.jpg'}')"
                  onmousemove="showPreview(event.clientX, event.clientY, '${product.image_url || '/images/placeholder-product.jpg'}')"
                  onmouseleave="hidePreview()"
                  onclick="event.preventDefault()"
                >
                  <span class="bg-white/90 text-gray-700 rounded-full p-2 shadow hover:bg-red-600 hover:text-white transition-colors duration-200">
                    <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                  </span>
                </button>
              </div>
              <div class="${currentViewMode === 'grid' 
                ? 'flex-1 flex flex-col px-2 pt-2 pb-1'
                : 'flex-1 ml-4 flex flex-col justify-between'
              }">
                <div class="${currentViewMode === 'grid' ? 'h-10 font-medium text-sm text-gray-900 line-clamp-2 mb-1' : 'font-medium text-gray-900 mb-2'}">
                  ${product.name}
                </div>
                <div class="${currentViewMode === 'grid' ? 'flex items-end gap-2 mb-1 mt-auto' : 'flex items-end gap-2 mb-2'}">
                  <span class="text-red-600 font-bold text-base">${product.price.toLocaleString('vi-VN')}₫</span>
                  ${product.original_price ? `<span class="text-xs text-gray-400 line-through">${product.original_price.toLocaleString('vi-VN')}₫</span>` : ''}
                </div>
                <div class="flex items-center justify-between gap-2 text-xs text-gray-500 mb-1">
                  <div class="flex items-center gap-2">
                    <span class="flex items-center gap-0.5">
                      <svg class="w-3 h-3 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                        <polygon points="9.9,1.1 7.6,6.6 1.6,7.3 6.1,11.2 4.8,17.1 9.9,14.1 15,17.1 13.7,11.2 18.2,7.3 12.2,6.6"/>
                      </svg>
                      ${(product.rating || 4.9).toFixed(1)}
                    </span>
                    <span>•</span>
                    <span>Đã bán ${product.sold_count || 0}</span>
                  </div>
                  <button 
                    class="p-1.5 bg-red-600 text-white rounded-full shadow hover:bg-red-700 transition-colors duration-200 buy-now-btn"
                    data-product='${JSON.stringify(product)}'
                    onclick="handleBuyNowClick(this)"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          </a>
        `;
      }).join('');
    }

    // Update product count
    function updateProductCount() {
      const countElement = document.getElementById('product-count');
      const mobileCountElement = document.getElementById('mobile-product-count');
      if (countElement) {
        countElement.textContent = `Hiển thị ${filteredProducts.length} sản phẩm`;
      }
      if (mobileCountElement) {
        mobileCountElement.textContent = filteredProducts.length;
      }
    }

    // Handle buy now click from server-rendered buttons
    function handleBuyNowClick(button) {
      const product = JSON.parse(button.dataset.product);
      openBuyNowModal(event, product);
    }

    // Open buy now modal
    function openBuyNowModal(event, product) {
      event.preventDefault();
      
      // Dispatch custom event to React component
      const modalEvent = new CustomEvent('openCategoryBuyNowModal', {
        detail: product
      });
      window.dispatchEvent(modalEvent);
    }

    // Initialize once when page loads
    let initialized = false;
    
    function init() {
      if (initialized) return;
      initialized = true;
      

      
      // Clear server-rendered products and render with JavaScript
      const container = document.getElementById('products-grid');
      if (container) {
        container.innerHTML = '';
      }
      
      populatePriceFilter();
      populateBrandFilter();
      applyFilters(); // Thay vì renderProducts để ensure filters are applied
      setupEventListeners();
    }
    
    function setupEventListeners() {
      // Note: Filter changes are now handled by inline onchange handlers
      
      // Sort dropdown
      const sortSelect = document.getElementById('sort-select');
      if (sortSelect) {
        sortSelect.addEventListener('change', function() {
          currentSort = this.value;
          sortProducts();
          renderProducts();
        });
      }
      
      // View mode buttons
      const gridView = document.getElementById('grid-view');
      const listView = document.getElementById('list-view');
      
      if (gridView) {
        gridView.addEventListener('click', function() {
          currentViewMode = 'grid';
          this.className = 'p-2 bg-red-600 text-white';
          if (listView) listView.className = 'p-2 bg-white text-gray-600';
          renderProducts();
        });
      }
      
      if (listView) {
        listView.addEventListener('click', function() {
          currentViewMode = 'list';
          this.className = 'p-2 bg-red-600 text-white';
          if (gridView) gridView.className = 'p-2 bg-white text-gray-600';
          renderProducts();
        });
      }

      // Clear filters
      const clearBtn = document.getElementById('clear-filters');
      if (clearBtn) {
        clearBtn.addEventListener('click', clearAllFilters);
      }

      // Mobile filter modal
      const mobileFilterBtn = document.getElementById('mobile-filter-btn');
      const mobileFilterModal = document.getElementById('mobile-filter-modal');
      const closeMobileFilter = document.getElementById('close-mobile-filter');
      const mobileFilterBackdrop = document.getElementById('mobile-filter-backdrop');
      const mobileClearFilters = document.getElementById('mobile-clear-filters');
      const mobileApplyFilters = document.getElementById('mobile-apply-filters');

      if (mobileFilterBtn && mobileFilterModal) {
        mobileFilterBtn.addEventListener('click', () => {
          mobileFilterModal.classList.remove('hidden');
        });
      }

      if (closeMobileFilter && mobileFilterModal) {
        closeMobileFilter.addEventListener('click', () => {
          mobileFilterModal.classList.add('hidden');
        });
      }

      if (mobileFilterBackdrop && mobileFilterModal) {
        mobileFilterBackdrop.addEventListener('click', () => {
          mobileFilterModal.classList.add('hidden');
        });
      }

      if (mobileClearFilters) {
        mobileClearFilters.addEventListener('click', () => {
          clearAllFilters();
          mobileFilterModal.classList.add('hidden');
        });
      }

      if (mobileApplyFilters && mobileFilterModal) {
        mobileApplyFilters.addEventListener('click', () => {
          mobileFilterModal.classList.add('hidden');
        });
      }
    }

    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    // Make functions globally available
    window.handleBuyNowClick = handleBuyNowClick;
    window.openBuyNowModal = openBuyNowModal;
    window.handlePriceRangeChange = handlePriceRangeChange;
    window.handleBrandChange = handleBrandChange;
    window.clearAllFilters = clearAllFilters;
    window.updateCheckboxStates = updateCheckboxStates;
    window.showPreview = showPreview;
    window.hidePreview = hidePreview;
  </script>
</Layout>

<style>
  .aspect-square {
    aspect-ratio: 1 / 1;
  }
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .animate-fade-in {
    animation: fadeIn 0.2s ease-in-out;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }
</style> 
</script> 