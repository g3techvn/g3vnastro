---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

let categories: Array<{
  id: number | string;
  title: string;
  description?: string;
  slug: string;
  image_url?: string;
  image_square_url?: string;
}> = [];

try {
  // Lấy dữ liệu trực tiếp từ Supabase
  const { data, error } = await supabase
    .from('product_cats')
    .select('*')
    .order('title', { ascending: true });

  if (error) {
    console.error('Error fetching categories:', error);
  } else {
    categories = data || [];
  }
} catch (error) {
  console.error('Error fetching categories:', error);
}

const title = 'Danh mục sản phẩm | G3 - Công Thái Học';
const description = 'Khám phá các danh mục sản phẩm công thái học tại G3.vn. Nội thất công thái học, bảo hành 12 tháng, giao hàng toàn quốc.';
---

<Layout title={title} description={description}>
  <!-- Mobile View -->
  <div class="md:hidden -mb-20">
    <div class="px-4 py-4">
      {categories.length > 0 ? (
        <div class="grid grid-cols-2 gap-4">
          {categories.map((category: any) => (
            <a href={`/categories/${category.slug}`} class="block">
              <div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
                <div class="aspect-square w-full overflow-hidden rounded-lg bg-gray-100">
                  {category.image_square_url || category.image_url ? (
                    <img
                      src={category.image_square_url || category.image_url}
                      alt={category.title}
                      class="h-full w-full object-contain"
                    />
                  ) : (
                    <div class="flex h-full items-center justify-center">
                      <span class="text-2xl font-bold text-gray-400">
                        {category.title.charAt(0)}
                      </span>
                    </div>
                  )}
                </div>
                <div class="mt-4">
                  <h3 class="text-lg font-semibold text-gray-900">
                    {category.title}
                  </h3>
                  {category.description && (
                    <p class="mt-1 text-sm text-gray-600">
                      {category.description}
                    </p>
                  )}
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="rounded-lg border border-gray-200 bg-white p-4 text-center shadow-sm">
          <p class="text-base text-gray-600">Không tìm thấy danh mục nào.</p>
        </div>
      )}
    </div>
  </div>

  <!-- Desktop View -->
  <div class="hidden md:block container mx-10 px-2 py-4">
    {categories.length > 0 ? (
      <div class="grid grid-cols-3 gap-4 lg:grid-cols-5">
        {categories.map((category: any) => (
          <a href={`/categories/${category.slug}`} class="block">
            <div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm hover:shadow-md transition-shadow">
              <div class="aspect-square w-full overflow-hidden rounded-lg bg-gray-100">
                {category.image_square_url || category.image_url ? (
                  <img
                    src={category.image_square_url || category.image_url}
                    alt={category.title}
                    class="h-full w-full object-contain"
                  />
                ) : (
                  <div class="flex h-full items-center justify-center">
                    <span class="text-2xl font-bold text-gray-400">
                      {category.title.charAt(0)}
                    </span>
                  </div>
                )}
              </div>
              <div class="mt-4">
                <h3 class="text-lg font-semibold text-gray-900">
                  {category.title}
                </h3>
                {category.description && (
                  <p class="mt-1 text-sm text-gray-600">
                    {category.description}
                  </p>
                )}
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="rounded-lg border border-gray-200 bg-white p-4 text-center shadow-sm">
        <p class="text-base text-gray-600">Không tìm thấy danh mục nào.</p>
      </div>
    )}
  </div>
</Layout>

<style>
  .aspect-square {
    aspect-ratio: 1 / 1;
  }
</style> 