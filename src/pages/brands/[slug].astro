---
import Layout from "../../layouts/Layout.astro";
import { supabase } from "../../lib/supabase";
import BrandPageWrapper from "../../components/react/BrandPageWrapper";

export async function getStaticPaths() {
  // Fetch all brands to generate static paths
  let brands: Array<{
    id: string;
    slug: string;
    title: string;
    image_url?: string;
    description?: string;
  }> = [];

  try {
    const { data, error } = await supabase
      .from("brands")
      .select("id, slug, title, image_url, description")
      .order("title", { ascending: true });

    if (!error && data) {
      brands = data;
    }
  } catch (error) {
    console.error("Error fetching brands for static paths:", error);
  }

  return brands.map((brand) => ({
    params: { slug: brand.slug },
    props: { brand },
  }));
}

const { slug } = Astro.params;
const { brand } = Astro.props;

const brandInfo = {
  title: brand?.title || slug || "Thương hiệu",
  description: brand?.description,
  image_url: brand?.image_url,
};

const title = `${brandInfo.title} | G3 - Công Thái Học`;
const description =
  brandInfo.description ||
  `Khám phá các sản phẩm của thương hiệu ${brandInfo.title} tại G3.vn. Nội thất công thái học, bảo hành 12 tháng, giao hàng toàn quốc.`;
---

<Layout title={title} description={description}>
  <BrandPageWrapper brandSlug={slug} brandData={brand} client:load />
</Layout>

