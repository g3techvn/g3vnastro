---
// Benefits section for enterprise landing page
---

<section class="py-20 bg-gray-50 overflow-hidden">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16 fade-in-up">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
        Lợi ích khi đầu tư 
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-600">
          nội thất công thái học
        </span>
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Khám phá những lợi ích thiết thực mà nội thất công thái học mang lại cho doanh nghiệp của bạn
      </p>
    </div>
    
    <!-- Hero Image Section -->
    <div class="mb-16 fade-in-up">
      <div class="relative overflow-hidden rounded-3xl shadow-2xl">
        <img 
          src="https://images.unsplash.com/photo-1497215842964-222b430dc094?w=1200&h=600&fit=crop&crop=center"
          alt="Modern office with ergonomic furniture"
          class="w-full h-96 object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-blue-600/80 to-cyan-600/60"></div>
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="text-center text-white">
            <h3 class="text-3xl font-bold mb-4">Không gian làm việc hiện đại</h3>
            <p class="text-xl max-w-2xl mx-auto">
              Tối ưu hóa năng suất và sức khỏe nhân viên với thiết kế công thái học
            </p>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Benefits Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-16">
      <!-- Benefit 1 -->
      <div class="group bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 fade-in-up" data-aos="fade-up" data-aos-delay="100">
        <div class="relative mb-6">
          <div class="w-16 h-16 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
          </div>
          <div class="absolute -top-2 -right-2 w-20 h-20 rounded-full overflow-hidden shadow-lg opacity-20 group-hover:opacity-100 transition-opacity duration-300">
            <img 
              src="https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?w=100&h=100&fit=crop&crop=center"
              alt="Ergonomic office chair"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-4">
          Giảm đau mỏi, tăng hiệu quả
        </h3>
        <p class="text-gray-600 leading-relaxed">
          Thiết kế công thái học giúp giảm tới 40% các chứng đau lưng, cổ vai gáy, tăng 25% hiệu suất làm việc
        </p>
      </div>
      
      <!-- Benefit 2 -->
      <div class="group bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 fade-in-up" data-aos="fade-up" data-aos-delay="200">
        <div class="relative mb-6">
          <div class="w-16 h-16 bg-gradient-to-br from-green-500 to-green-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
            </svg>
          </div>
          <div class="absolute -top-2 -right-2 w-20 h-20 rounded-full overflow-hidden shadow-lg opacity-20 group-hover:opacity-100 transition-opacity duration-300">
            <img 
              src="https://images.unsplash.com/photo-1497366811353-6870744d04b2?w=100&h=100&fit=crop&crop=center"
              alt="Happy office workers"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-4">
          Cải thiện tinh thần làm việc
        </h3>
        <p class="text-gray-600 leading-relaxed">
          Không gian làm việc thoải mái giúp nâng cao sự tập trung, giảm stress và tăng cường động lực nhân viên
        </p>
      </div>
      
      <!-- Benefit 3 -->
      <div class="group bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 fade-in-up" data-aos="fade-up" data-aos-delay="300">
        <div class="relative mb-6">
          <div class="w-16 h-16 bg-gradient-to-br from-purple-500 to-purple-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
          </div>
          <div class="absolute -top-2 -right-2 w-20 h-20 rounded-full overflow-hidden shadow-lg opacity-20 group-hover:opacity-100 transition-opacity duration-300">
            <img 
              src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=100&h=100&fit=crop&crop=center"
              alt="Modern office building"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-4">
          Nâng tầm hình ảnh doanh nghiệp
        </h3>
        <p class="text-gray-600 leading-relaxed">
          Văn phòng hiện đại, chuyên nghiệp tạo ấn tượng mạnh với khách hàng và đối tác, thu hút nhân tài
        </p>
      </div>
      
      <!-- Benefit 4 -->
      <div class="group bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 fade-in-up" data-aos="fade-up" data-aos-delay="400">
        <div class="relative mb-6">
          <div class="w-16 h-16 bg-gradient-to-br from-orange-500 to-orange-600 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div class="absolute -top-2 -right-2 w-20 h-20 rounded-full overflow-hidden shadow-lg opacity-20 group-hover:opacity-100 transition-opacity duration-300">
            <img 
              src="https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=100&h=100&fit=crop&crop=center"
              alt="Cost savings chart"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-4">
          Tối ưu chi phí dài hạn
        </h3>
        <p class="text-gray-600 leading-relaxed">
          Sản phẩm bền bỉ, bảo hành dài hạn giúp tiết kiệm chi phí thay thế và bảo trì trong tương lai
        </p>
      </div>
    </div>
    
    <!-- Before/After Comparison -->
    <div class="mb-16 fade-in-up">
      <div class="bg-white rounded-3xl p-8 shadow-2xl">
        <h3 class="text-2xl font-bold text-gray-900 mb-8 text-center">
          So sánh trước và sau khi áp dụng
        </h3>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <div class="relative group">
            <div class="absolute -top-4 -left-4 bg-red-500 text-white px-4 py-2 rounded-full text-sm font-semibold z-10">
              Trước
            </div>
            <div class="relative overflow-hidden rounded-2xl">
              <img 
                src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=600&h=400&fit=crop&crop=center"
                alt="Traditional office setup"
                class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-300"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              <div class="absolute bottom-4 left-4 text-white">
                <div class="font-semibold">Văn phòng truyền thống</div>
                <div class="text-sm">Thiết kế cũ kỹ, không tối ưu</div>
              </div>
            </div>
          </div>
          
          <div class="relative group">
            <div class="absolute -top-4 -left-4 bg-green-500 text-white px-4 py-2 rounded-full text-sm font-semibold z-10">
              Sau
            </div>
            <div class="relative overflow-hidden rounded-2xl">
              <img 
                src="https://images.unsplash.com/photo-1497366754035-f200968a6e72?w=600&h=400&fit=crop&crop=center"
                alt="Modern ergonomic office"
                class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-300"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              <div class="absolute bottom-4 left-4 text-white">
                <div class="font-semibold">Văn phòng hiện đại</div>
                <div class="text-sm">Thiết kế công thái học tối ưu</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Additional Info -->
    <div class="bg-gradient-to-r from-blue-600 to-cyan-600 rounded-2xl p-8 text-center fade-in-up">
      <h3 class="text-2xl font-bold text-white mb-4">
        Đã được chứng minh bởi nghiên cứu khoa học
      </h3>
      <p class="text-blue-100 text-lg max-w-3xl mx-auto mb-6">
        Theo nghiên cứu của Đại học Y Harvard, môi trường làm việc công thái học có thể giảm tới 60% nguy cơ mắc các bệnh về cơ xương khớp nghề nghiệp
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 justify-center">
        <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-lg px-6 py-4 hover:bg-white/20 transition-colors duration-300">
          <div class="text-2xl font-bold text-white counter-stat" data-count="60">0</div>
          <div class="text-sm text-blue-100">Giảm bệnh nghề nghiệp</div>
        </div>
        <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-lg px-6 py-4 hover:bg-white/20 transition-colors duration-300">
          <div class="text-2xl font-bold text-white counter-stat" data-count="40">0</div>
          <div class="text-sm text-blue-100">Giảm đau mỏi</div>
        </div>
        <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-lg px-6 py-4 hover:bg-white/20 transition-colors duration-300">
          <div class="text-2xl font-bold text-white counter-stat" data-count="25">0</div>
          <div class="text-sm text-blue-100">Tăng hiệu suất</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .fade-in-up {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s ease-out;
  }
  
  .fade-in-up.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  // Intersection Observer for fade-in animations
  document.addEventListener('DOMContentLoaded', function() {
    const fadeElements = document.querySelectorAll('.fade-in-up');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    });
    
    fadeElements.forEach(element => {
      observer.observe(element);
    });
    
    // Counter animation for stats
    const statCounters = document.querySelectorAll('.counter-stat');
    const animateStatCounter = (counter) => {
      const target = parseInt(counter.getAttribute('data-count') || '0');
      const duration = 2000;
      let current = 0;
      const increment = target / (duration / 16);
      
      const updateCounter = () => {
        current += increment;
        if (current < target) {
          counter.textContent = Math.floor(current);
          requestAnimationFrame(updateCounter);
        } else {
          counter.textContent = target + '%';
        }
      };
      
      updateCounter();
    };
    
    const statObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          animateStatCounter(entry.target);
          statObserver.unobserve(entry.target);
        }
      });
    });
    
    statCounters.forEach(counter => {
      statObserver.observe(counter);
    });
  });
</script> 